    },
    {
      "type": "text", "id": "p4_desc", "x": 1000, "y": 163, "width": 560, "height": 44,
      "text": "Whoever holds it can trade it; rotation swaps it on each use.",
      "originalText": "Whoever holds it can trade it; rotation swaps it on each use.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
