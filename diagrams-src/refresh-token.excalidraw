    },
    {
      "type": "text", "id": "p2_title", "x": -160, "y": 390, "width": 600, "height": 24,
      "text": "Redemption Model: Renewable", "originalText": "Redemption Model: Renewable",
      "fontSize": 19, "fontFamily": 3, "textAlign": "right", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 440074, "version": 1, "versionNonce": 440075, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p2_desc", "x": -160, "y": 418, "width": 600, "height": 44,
      "text": "Trade it at the booth for a fresh ride ticket, again and again.",
      "originalText": "Trade it at the booth for a fresh ride ticket, again and again.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "right", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 440076, "version": 1, "versionNonce": 440077, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p3_title", "x": -160, "y": 645, "width": 600, "height": 24,
      "text": "Validity Window: Long-lived", "originalText": "Validity Window: Long-lived",
      "fontSize": 19, "fontFamily": 3, "textAlign": "right", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 440078, "version": 1, "versionNonce": 440079, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p3_desc", "x": -160, "y": 673, "width": 600, "height": 44,
      "text": "Lasts far longer than a ride ticket — days or weeks, not one visit.",
      "originalText": "Lasts far longer than a ride ticket — days or weeks, not one visit.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "right", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
