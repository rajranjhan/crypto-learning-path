      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p5_desc", "x": 1000, "y": 418, "width": 560, "height": 44,
      "text": "By default just held; it can be bound like the ride ticket for more safety.",
      "originalText": "By default just held; it can be bound like the ride ticket for more safety.",
