    {
      "type": "text", "id": "p1_title", "x": -160, "y": 135, "width": 600, "height": 24,
      "text": "Issuer Trust: Implicit", "originalText": "Issuer Trust: Implicit",
      "fontSize": 19, "fontFamily": 3, "textAlign": "right", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400070, "version": 1, "versionNonce": 400071, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p1_desc", "x": -160, "y": 163, "width": 600, "height": 40,
      "text": "Trust comes from proximity & context — you're standing right at the booth.",
      "originalText": "Trust comes from proximity & context — you're standing right at the booth.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "right", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400072, "version": 1, "versionNonce": 400073, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p2_title", "x": -160, "y": 390, "width": 600, "height": 24,
      "text": "Redemption Model: Scoped", "originalText": "Redemption Model: Scoped",
      "fontSize": 19, "fontFamily": 3, "textAlign": "right", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400074, "version": 1, "versionNonce": 400075, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p2_desc", "x": -160, "y": 418, "width": 600, "height": 40,
      "text": "Good for one item — one ticket buys one ride, then it's spent.",
      "originalText": "Good for one item — one ticket buys one ride, then it's spent.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "right", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400076, "version": 1, "versionNonce": 400077, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p3_title", "x": -160, "y": 645, "width": 600, "height": 24,
      "text": "Validity Window: None", "originalText": "Validity Window: None",
      "fontSize": 19, "fontFamily": 3, "textAlign": "right", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400078, "version": 1, "versionNonce": 400079, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p3_desc", "x": -160, "y": 673, "width": 600, "height": 40,
      "text": "The ticket is good for as long as the booth keeps accepting it.",
      "originalText": "The ticket is good for as long as the booth keeps accepting it.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "right", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400080, "version": 1, "versionNonce": 400081, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },

    {
      "type": "text", "id": "p4_title", "x": 1000, "y": 135, "width": 600, "height": 24,
      "text": "Authorization: Bearer", "originalText": "Authorization: Bearer",
      "fontSize": 19, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400082, "version": 1, "versionNonce": 400083, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p4_desc", "x": 1000, "y": 163, "width": 600, "height": 40,
      "text": "Whoever holds the ticket gets the ride. No name, no ID check.",
      "originalText": "Whoever holds the ticket gets the ride. No name, no ID check.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400084, "version": 1, "versionNonce": 400085, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p5_title", "x": 1000, "y": 390, "width": 600, "height": 24,
      "text": "Proof of Possession: None", "originalText": "Proof of Possession: None",
      "fontSize": 19, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400086, "version": 1, "versionNonce": 400087, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p5_desc", "x": 1000, "y": 418, "width": 600, "height": 40,
      "text": "No enforced link between the buyer and whoever redeems it.",
      "originalText": "No enforced link between the buyer and whoever redeems it.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400088, "version": 1, "versionNonce": 400089, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p6_title", "x": 1000, "y": 645, "width": 600, "height": 24,
      "text": "Revocation: None", "originalText": "Revocation: None",
      "fontSize": 19, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400090, "version": 1, "versionNonce": 400091, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p6_desc", "x": 1000, "y": 673, "width": 600, "height": 40,
      "text": "No way to invalidate a lost or stolen ticket; the booth can only refuse service.",
      "originalText": "No way to invalidate a lost or stolen ticket; the booth can only refuse service.",
