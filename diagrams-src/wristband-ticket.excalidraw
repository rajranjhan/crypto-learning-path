    {
      "type": "text", "id": "p1_title", "x": -160, "y": 135, "width": 600, "height": 24,
      "text": "Issuer Trust: Verified", "originalText": "Issuer Trust: Verified",
      "fontSize": 19, "fontFamily": 3, "textAlign": "right", "verticalAlign": "top",
      "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 430070, "version": 1, "versionNonce": 430071, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p1_desc", "x": -160, "y": 163, "width": 600, "height": 44,
      "text": "The band comes from the carnival's official station — a real chain of trust.",
      "originalText": "The band comes from the carnival's official station — a real chain of trust.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "right", "verticalAlign": "top",
      "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 430072, "version": 1, "versionNonce": 430073, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p2_title", "x": -160, "y": 390, "width": 600, "height": 24,
      "text": "Redemption Model: Scoped", "originalText": "Redemption Model: Scoped",
      "fontSize": 19, "fontFamily": 3, "textAlign": "right", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 430074, "version": 1, "versionNonce": 430075, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p2_desc", "x": -160, "y": 418, "width": 600, "height": 44,
      "text": "Unchanged — still good for one item, one ride, then it's spent.",
      "originalText": "Unchanged — still good for one item, one ride, then it's spent.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "right", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 430076, "version": 1, "versionNonce": 430077, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p3_title", "x": -160, "y": 645, "width": 600, "height": 24,
      "text": "Validity Window: Session-long", "originalText": "Validity Window: Session-long",
      "fontSize": 19, "fontFamily": 3, "textAlign": "right", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 430078, "version": 1, "versionNonce": 430079, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p3_desc", "x": -160, "y": 673, "width": 600, "height": 44,
      "text": "The band works all day while it's on your wrist — no per-ride freshness.",
      "originalText": "The band works all day while it's on your wrist — no per-ride freshness.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "right", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 430080, "version": 1, "versionNonce": 430081, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },

    {
      "type": "text", "id": "p4_title", "x": 1000, "y": 135, "width": 600, "height": 24,
      "text": "Authorization: Sender-constrained", "originalText": "Authorization: Sender-constrained",
      "fontSize": 19, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 430082, "version": 1, "versionNonce": 430083, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p4_desc", "x": 1000, "y": 163, "width": 520, "height": 44,
      "text": "Only the wrist wearing the matching band rides — the ticket alone won't do.",
      "originalText": "Only the wrist wearing the matching band rides — the ticket alone won't do.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 430084, "version": 1, "versionNonce": 430085, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p5_title", "x": 1000, "y": 390, "width": 600, "height": 24,
      "text": "Proof of Possession: Enforced", "originalText": "Proof of Possession: Enforced",
      "fontSize": 19, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 430086, "version": 1, "versionNonce": 430087, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p5_desc", "x": 1000, "y": 418, "width": 520, "height": 44,
      "text": "The gate checks your wristband against the ticket — the two must match.",
      "originalText": "The gate checks your wristband against the ticket — the two must match.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 430088, "version": 1, "versionNonce": 430089, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p6_title", "x": 1000, "y": 645, "width": 600, "height": 24,
      "text": "Revocation: Still limited", "originalText": "Revocation: Still limited",
      "fontSize": 19, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 430090, "version": 1, "versionNonce": 430091, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "p6_desc", "x": 1000, "y": 673, "width": 520, "height": 44,
      "text": "Still hard to cancel one lost band; the station can only refuse a known-bad one.",
      "originalText": "Still hard to cancel one lost band; the station can only refuse a known-bad one.",
